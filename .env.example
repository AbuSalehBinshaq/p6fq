# Render PostgreSQL internal connection URL. Do not commit a real value.
DATABASE_URL=
# Neon requires encrypted PostgreSQL connections.
DATABASE_SSL=true
# Discord webhook used to alert the owner of a new conversation request.
DISCORD_WEBHOOK_URL=
# Password that protects the owner-only /orders dashboard. Do not commit a real value.
ORDERS_DASHBOARD_PASSWORD=
# Public identifiers used to load Google Analytics and Microsoft Clarity in the browser.
VITE_GA_MEASUREMENT_ID=
VITE_CLARITY_PROJECT_ID=
# Automatically set by Render at runtime; keep this value for local production testing.
PORT=10000
NODE_ENV=production
