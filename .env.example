# Render PostgreSQL internal connection URL. Do not commit a real value.
DATABASE_URL=
# Neon requires encrypted PostgreSQL connections.
DATABASE_SSL=true
# Discord webhook used to alert the owner of a new conversation request.
DISCORD_WEBHOOK_URL=
# Password that protects the owner-only /orders dashboard. Do not commit a real value.
ORDERS_DASHBOARD_PASSWORD=
# Public identifiers used to load Google Analytics and Microsoft Clarity in the browser.
VITE_GA_MEASUREMENT_ID=
VITE_CLARITY_PROJECT_ID=
# Telegram BotFather token. Never commit a real token.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID for owner notifications.
TELEGRAM_OWNER_ID=
# Optional secret used to verify Telegram webhook requests.
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS endpoint receiving Telegram updates.
TELEGRAM_WEBHOOK_URL=https://batal-story.onrender.com/api/telegram/webhook
# Automatically set by Render at runtime; keep this value for local production testing.
PORT=10000
NODE_ENV=production
